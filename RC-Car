#include <SoftwareSerial.h>

// Bluetooth module (HC-05)
SoftwareSerial BT(10, 11); // RX, TX

char data;

// Motor pins (L298N)
int m1a=2; int m1b=3;
int m2a=4; int m2b=5;
int m3a=6; int m3b=7;
int m4a=8; int m4b=9;

void setup()
{
    pinMode(m1a,OUTPUT); pinMode(m1b,OUTPUT);
    pinMode(m2a,OUTPUT); pinMode(m2b,OUTPUT);
    pinMode(m3a,OUTPUT); pinMode(m3b,OUTPUT);
    pinMode(m4a,OUTPUT); pinMode(m4b,OUTPUT);

    Serial.begin(9600);   // USB monitor
    BT.begin(9600);       // Bluetooth communication
}

void loop()
{
    if(BT.available())
    {
        data = BT.read();

        // Forward
        if(data=='1')
        {
            forward();
        }

        // Backward
        else if(data=='2')
        {
            backward();
        }

        // Left
        else if(data=='3')
        {
            left();
        }

        // Right
        else if(data=='4')
        {
            right();
        }

        // Stop
        else if(data=='0')
        {
            stopRobot();
        }
    }
}

// ---------------- MOVEMENTS ----------------

void forward()
{
    m1f(); m2f(); m3f(); m4f();
}

void backward()
{
    m1b(); m2b(); m3b(); m4b();
}

void left()
{
    m1b(); m2f(); m3f(); m4b();
}

void right()
{
    m1f(); m2b(); m3b(); m4f();
}

void stopRobot()
{
    m1s(); m2s(); m3s(); m4s();
}

// ---------------- MOTOR FUNCTIONS ----------------

void m1f(){digitalWrite(m1a,HIGH); digitalWrite(m1b,LOW);}
void m1b(){digitalWrite(m1a,LOW); digitalWrite(m1b,HIGH);}
void m1s(){digitalWrite(m1a,LOW); digitalWrite(m1b,LOW);}

void m2f(){digitalWrite(m2a,HIGH); digitalWrite(m2b,LOW);}
void m2b(){digitalWrite(m2a,LOW); digitalWrite(m2b,HIGH);}
void m2s(){digitalWrite(m2a,LOW); digitalWrite(m2b,LOW);}

void m3f(){digitalWrite(m3a,HIGH); digitalWrite(m3b,LOW);}
void m3b(){digitalWrite(m3a,LOW); digitalWrite(m3b,HIGH);}
void m3s(){digitalWrite(m3a,LOW); digitalWrite(m3b,LOW);}

void m4f(){digitalWrite(m4a,HIGH); digitalWrite(m4b,LOW);}
void m4b(){digitalWrite(m4a,LOW); digitalWrite(m4b,HIGH);}
void m4s(){digitalWrite(m4a,LOW); digitalWrite(m4b,LOW);}
